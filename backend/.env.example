# SOS Connection backend environment variables (example)
# Replace with your real values in .env

# Stripe secret key (starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Stripe webhook signing secret (from Stripe Dashboard > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_801cfaa01c7a39878236de935f3875824b409c0bf45980fb0ee46ff395c71e68

# Admin login credentials (hardcoded)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password123

# Secret for signing auth tokens
AUTH_JWT_SECRET=change_me

# Frontend base URL for redirect after Stripe Checkout
FRONTEND_URL=http://localhost:5173

# Pre-authorization amount in EUR (integer euros)
AUTH_AMOUNT_EUR=50

# Database connection URL (PostgreSQL example)
DATABASE_URL="postgresql://user:password@localhost:5432/sos?schema=public"

# Logger level: debug | info | warn | error
LOG_LEVEL=debug