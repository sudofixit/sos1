@ADMIN_EMAIL = admin@example.com
@ADMIN_PASSWORD = password123
@adminCookie = admin_token=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhZG1pbkBleGFtcGxlLmNvbSIsInJvbGUiOiJhZG1pbiIsImV4cCI6MTc2MTIxNzU0Nn0.TLSQbfizQeEcW9Z53HeLApGIikndWSdsNips3g1uppo
@adminToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhZG1pbkBleGFtcGxlLmNvbSIsInJvbGUiOiJhZG1pbiIsImV4cCI6MTc2MTIxNzU0Nn0.TLSQbfizQeEcW9Z53HeLApGIikndWSdsNips3g1uppo
@checkoutSessionId = cs_test_a1XJpBGUsFnPPZn6mKWzS9LalwQIz3qvgNasEMA6z0gD2IWIpiQUP0GRrP
@payment_intent_id = pi_3SL0FJSC1SGQ8hbn0OBmidq0
